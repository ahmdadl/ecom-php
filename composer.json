{
    "name": "hassanzohdy/mongez",
    "description": "Mongez package for Laravel with MongoDB support",
    "keywords": ["laravel", "mongodb", "mongez", "octane", "frankenphp"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "cocur/slugify": "^4.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "mongodb/laravel-mongodb": "^5.8"
    },
    "suggest": {
        "laravel/octane": "Required to run the package under Laravel Octane (Octane-safe state reset is registered automatically)."
    },
    "authors": [
        {
            "name": "Hasan Zohdy",
            "email": "hassanzohdy@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "HZ\\Illuminate\\Mongez\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "HZ\\Illuminate\\Mongez\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HZ\\Illuminate\\Mongez\\Providers\\MongezServiceProvider"
            ]
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.3"
    }
}
